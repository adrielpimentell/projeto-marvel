rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPlayerName(name) {
      return name is string && name.matches('^[A-Za-z0-9_]{3,20}$');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function namePath(name) {
      return /databases/$(database)/documents/usernames/$(name.lower());
    }

    function validSeason(seasonId) {
      return seasonId.matches('^[0-9]{4}-W[0-9]{2}$');
    }

    function prizesOnlyGrow(before, after) {
      return after is list && after.hasAll(before) && after.size() <= before.size() + 1;
    }

    function validStep(before, after) {
      return after is int
        && (after == before + 10
          || (before >= 5 && after == before - 5)
          || (before < 5 && after == 0));
    }

    match /usernames/{nameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && nameKey.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.nomeJogador.lower() == nameKey;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nomeJogador'])
        && validPlayerName(request.resource.data.nomeJogador)
        && getAfter(namePath(request.resource.data.nomeJogador)).data.uid == uid;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['temporada', 'premiosRecebidos'])
        && (!('temporada' in request.resource.data) || validSeason(request.resource.data.temporada))
        && prizesOnlyGrow(resource.data.get('premiosRecebidos', []),
                          request.resource.data.get('premiosRecebidos', []));
      allow delete: if false;
    }

    match /temporadas/{seasonId}/jogadores/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && validSeason(seasonId)
        && request.resource.data.keys().hasAll(['nomeJogador', 'trofeus', 'atualizadoEm'])
        && request.resource.data.keys().hasOnly(['nomeJogador', 'trofeus', 'atualizadoEm'])
        && request.resource.data.nomeJogador == get(userPath(uid)).data.nomeJogador
        && request.resource.data.trofeus in [0, 10]
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trofeus', 'atualizadoEm'])
        && validStep(resource.data.trofeus, request.resource.data.trofeus)
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }
  }
}
