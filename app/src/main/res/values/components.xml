<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Marvel.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="rippleColor">@color/red_translucent</item>
    </style>

    <style name="Widget.Marvel.Button.Compact">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">@dimen/button_compact_inset</item>
        <item name="android:insetBottom">@dimen/button_compact_inset</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Marvel.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="iconTint">@color/red</item>
        <item name="rippleColor">@color/red_translucent</item>
    </style>

    <style name="Widget.Marvel.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <style name="Widget.Marvel.ScreenTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.Display</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Widget.Marvel.ScreenSubtitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.BodySmall</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Marvel.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill_surface</item>
        <item name="android:paddingStart">@dimen/card_padding_compact</item>
        <item name="android:paddingEnd">@dimen/card_padding_compact</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Marvel.Pill.Accent">
        <item name="android:background">@drawable/bg_pill_red</item>
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="Widget.Marvel.SkeletonBlock" parent="">
        <item name="android:background">@drawable/bg_skeleton</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.Marvel.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_md</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/red</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="counterTextColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Marvel.TextField.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.BodyLarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Marvel.LinkButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.Body</item>
        <item name="rippleColor">@color/red_translucent</item>
    </style>
</resources>
