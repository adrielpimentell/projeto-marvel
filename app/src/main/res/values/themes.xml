<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Marvel" parent="Theme.Material3.Dark.NoActionBar" />

    <style name="Theme.Marvel" parent="Base.Theme.Marvel">
        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorControlActivated">@color/red</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorHighlight">@color/red_translucent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="materialCardViewStyle">@style/Widget.Marvel.Card</item>
    </style>

    <style name="Theme.Marvel.Splash" parent="Theme.Marvel">
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Marvel.Overlay" parent="Theme.Marvel">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="TextAppearance.Marvel.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/bebas_neue</item>
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Widget.Marvel.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">@dimen/space_sm</item>
        <item name="chipEndPadding">@dimen/space_sm</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/red_translucent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Marvel.Pill</item>
    </style>

    <style name="Widget.Marvel.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="iconTint">@color/button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_md</item>
    </style>

    <style name="Widget.Marvel.InfoChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_high</item>
        <item name="android:textColor">@color/text_label</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="rippleColor">@color/red_translucent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Marvel.Pill</item>
    </style>

    <style name="Widget.Marvel.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.Label</item>
    </style>

    <style name="Widget.Marvel.StatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.TitleLarge</item>
    </style>

    <style name="Widget.Marvel.StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Marvel.Caption</item>
    </style>

    <style name="Widget.Marvel.FighterName" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Marvel.AttributeBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:max">100</item>
        <item name="indicatorColor">@color/red</item>
        <item name="trackColor">@color/divider</item>
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <style name="Widget.Marvel.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.Marvel.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Marvel.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>
</resources>
