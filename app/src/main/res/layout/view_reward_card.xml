<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/artifact_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0"
    app:strokeWidth="2dp"
    tools:alpha="1"
    tools:strokeColor="@color/rarity_legendary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/artifact_rarity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_surface"
            android:paddingStart="@dimen/card_padding_compact"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/card_padding_compact"
            android:paddingBottom="@dimen/space_xs"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Lendário"
            tools:textColor="@color/rarity_legendary" />

        <TextView
            android:id="@+id/artifact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Marvel.Display"
            android:textColor="@color/text_primary"
            tools:text="Martelo do Trovão"/>

        <TextView
            android:id="@+id/artifact_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Efeito especial" />

        <TextView
            android:id="@+id/artifact_effect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_label"
            android:textAppearance="@style/TextAppearance.Marvel.BodyLarge"
            tools:text="20% de chance de atordoar: o inimigo perde o próximo turno"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
