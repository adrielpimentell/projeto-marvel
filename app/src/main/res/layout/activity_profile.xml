<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ProfileActivity">

    <ImageButton
        android:id="@+id/profile_back"
        style="@style/Widget.Marvel.IconButton"
        android:layout_marginStart="@dimen/card_padding_compact"
        android:layout_marginTop="@dimen/space_sm"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        style="@style/Widget.Marvel.ScreenTitle"
        android:layout_marginStart="@dimen/space_xs"
        android:accessibilityHeading="true"
        android:text="@string/profile_title"
        app:layout_constraintBottom_toBottomOf="@id/profile_back"
        app:layout_constraintStart_toEndOf="@id/profile_back"
        app:layout_constraintTop_toTopOf="@id/profile_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg">

            <FrameLayout
                android:layout_width="@dimen/profile_avatar_size"
                android:layout_height="@dimen/profile_avatar_size"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="noHideDescendants">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/avatar_1"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Marvel.DisplayLarge"
                    android:textColor="@color/text_primary"
                    tools:text="T" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_ring" />
            </FrameLayout>

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Marvel.Display"
                android:textColor="@color/text_primary"
                tools:text="teste123" />

            <TextView
                android:id="@+id/profile_email_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
                tools:text="teste@email.com · Sentinela" />

            <TextView
                android:id="@+id/profile_since"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Marvel.Caption"
                tools:text="Jogando desde 05/10/2026" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/profile_season"
                        android:textAppearance="@style/TextAppearance.Marvel.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/profile_season_trophies"
                            layout="@layout/view_stat_column" />

                        <include
                            android:id="@+id/profile_season_position"
                            layout="@layout/view_stat_column" />

                        <include
                            android:id="@+id/profile_season_time"
                            layout="@layout/view_stat_column" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/profile_season_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Marvel.Caption"
                        android:visibility="gone"
                        tools:text="Jogue uma batalha para entrar no ranking desta semana."
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/profile_collection"
                        android:textAppearance="@style/TextAppearance.Marvel.Label" />

                    <LinearLayout
                        android:id="@+id/profile_collection_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/profile_rarity_common"
                            layout="@layout/view_stat_column" />

                        <include
                            android:id="@+id/profile_rarity_rare"
                            layout="@layout/view_stat_column" />

                        <include
                            android:id="@+id/profile_rarity_epic"
                            layout="@layout/view_stat_column" />

                        <include
                            android:id="@+id/profile_rarity_legendary"
                            layout="@layout/view_stat_column" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/profile_records"
                        android:textAppearance="@style/TextAppearance.Marvel.Label" />

                    <LinearLayout
                        android:id="@+id/profile_records_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
