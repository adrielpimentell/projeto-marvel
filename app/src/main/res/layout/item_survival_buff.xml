<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    app:strokeColor="@color/divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding_compact">

        <ImageView
            android:id="@+id/buff_icon"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:background="@drawable/bg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_sm"
            tools:src="@drawable/ic_bolt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_padding_compact"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/buff_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Marvel.Title"
                android:textStyle="bold"
                tools:text="Fúria"/>

            <TextView
                android:id="@+id/buff_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
                tools:text="+20% de dano (acumula)"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
