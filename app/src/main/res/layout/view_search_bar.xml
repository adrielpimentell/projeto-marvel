<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/bg_search"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="0dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        app:tint="@color/text_secondary" />

    <EditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/card_padding_compact"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textNoSuggestions"
        android:maxLength="40"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Marvel.BodyLarge"
        android:textColorHint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/search_clear"
        style="@style/Widget.Marvel.IconButton"
        android:contentDescription="@string/search_clear"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="@color/text_secondary" />
</LinearLayout>
