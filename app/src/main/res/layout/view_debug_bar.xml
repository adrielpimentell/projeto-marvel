<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/debug_label"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_add_trophies"
            style="@style/Widget.Marvel.DebugButton"
            android:text="@string/debug_add_trophies" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_end_season"
            style="@style/Widget.Marvel.DebugButton"
            android:text="@string/debug_end_season" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_add_coins"
            style="@style/Widget.Marvel.DebugButton"
            android:text="@string/debug_add_coins" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_add_coins_big"
            style="@style/Widget.Marvel.DebugButton"
            android:text="@string/debug_add_coins_big" />
    </LinearLayout>
</HorizontalScrollView>
