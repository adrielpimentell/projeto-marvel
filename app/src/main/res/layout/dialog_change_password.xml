<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_current_layout"
            style="@style/Widget.Marvel.TextField"
            android:hint="@string/password_current"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_current"
                style="@style/Widget.Marvel.TextField.Input"
                android:inputType="textPassword"
                android:autofillHints="password" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_new_layout"
            style="@style/Widget.Marvel.TextField"
            android:hint="@string/password_new"
            app:endIconMode="password_toggle"
            app:helperText="@string/auth_password_helper"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_new"
                style="@style/Widget.Marvel.TextField.Input"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_confirm_layout"
            style="@style/Widget.Marvel.TextField"
            android:hint="@string/auth_password_confirm"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_confirm"
                style="@style/Widget.Marvel.TextField.Input"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/dialog_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Marvel.Body"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Sem conexão"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/dialog_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:contentDescription="@string/auth_loading"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/red"
            app:indicatorSize="@dimen/icon_md"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
