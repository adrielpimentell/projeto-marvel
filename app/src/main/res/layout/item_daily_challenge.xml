<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_padding_compact"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/daily_icon"
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:importantForAccessibility="no"
            app:tint="@color/red"
            tools:src="@drawable/ic_trophy" />

        <TextView
            android:id="@+id/daily_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_label"
            android:textAppearance="@style/TextAppearance.Marvel.Body"
            tools:text="Vença com um herói da equipe X-Men"/>

        <TextView
            android:id="@+id/daily_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="+250" />
    </LinearLayout>

    <TextView
        android:id="@+id/daily_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Marvel.Caption"
        tools:text="Vale com: Wolverine, Storm"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/daily_bar"
            style="@style/Widget.Marvel.AttributeBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="50" />

        <TextView
            android:id="@+id/daily_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:minWidth="36dp"
            android:textColor="@color/text_muted"
            android:textAppearance="@style/TextAppearance.Marvel.Caption"
            tools:text="1/2"/>
    </LinearLayout>
</LinearLayout>
