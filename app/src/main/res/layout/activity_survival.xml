<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/survival_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.survival.SurvivalActivity">

    <ImageButton
        android:id="@+id/back_button"
        style="@style/Widget.Marvel.IconButton"
        android:layout_marginStart="@dimen/card_padding_compact"
        android:layout_marginTop="@dimen/space_sm"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/player_hud"
        layout="@layout/view_player_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_button"
        app:layout_constraintTop_toTopOf="@id/back_button" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                style="@style/Widget.Marvel.ScreenTitle"
                android:text="@string/survival_title" />

            <TextView
                android:id="@+id/survival_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_label"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_trophy"
                app:drawableTint="@color/rarity_legendary"
                tools:text="Recorde: andar 7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/survival_chest"
                style="@style/Widget.Marvel.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding_compact"
                android:text="@string/survival_open_chest"
                android:visibility="gone"
                app:icon="@drawable/ic_chest"
                app:iconGravity="textStart"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/survival_idle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/survival_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_label"
                    android:textAppearance="@style/TextAppearance.Marvel.Body"
                    tools:text="@string/survival_rules"/>

                <TextView
                    android:id="@+id/survival_last_run"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
                    android:visibility="gone"
                    tools:text="Última partida: terminou no andar 6 · +300 moedas"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/survival_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Herói: Lucas Jackson · OVR 24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/survival_start"
                    style="@style/Widget.Marvel.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:text="@string/survival_start"
                    app:icon="@drawable/ic_bolt"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/survival_run"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/survival_floor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Marvel.Display"
                            android:textColor="@color/text_primary"
                            tools:text="Andar 5"/>

                        <TextView
                            android:id="@+id/survival_power"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Marvel.Pill.Accent"
                            android:layout_marginBottom="@dimen/space_sm"
                            tools:text="Inimigo com 73% de poder" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/survival_hero_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textColor="@color/text_label"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Lucas Jackson" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/survival_hp_bar"
                            style="@style/Widget.Marvel.AttributeBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:indicatorColor="@color/green"
                            tools:progress="70" />

                        <TextView
                            android:id="@+id/survival_hp_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:textColor="@color/text_label"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="180/260" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/survival_buffs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textColor="@color/text_muted"
                        android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
                        tools:text="Bônus: Fúria ×2 · Sanguessuga"/>

                    <TextView
                        android:id="@+id/survival_run_coins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Marvel.Caption"
                        tools:text="Moedas nesta partida: 300"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/survival_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.Marvel.SectionLabel"
                        android:layout_marginTop="@dimen/space_lg"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:text="@string/survival_choose" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/survival_choose_hint"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Marvel.Caption"/>

                    <include
                        android:id="@+id/survival_buff_0"
                        layout="@layout/item_survival_buff" />

                    <include
                        android:id="@+id/survival_buff_1"
                        layout="@layout/item_survival_buff" />

                    <include
                        android:id="@+id/survival_buff_2"
                        layout="@layout/item_survival_buff" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/survival_enemy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Marvel.SectionLabel"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/survival_next_enemy" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:minHeight="110dp"
                        android:padding="@dimen/space_sm">

                        <ProgressBar
                            android:id="@+id/survival_enemy_loading"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/red" />

                        <LinearLayout
                            android:id="@+id/survival_enemy_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/survival_enemy_image"
                                android:layout_width="72dp"
                                android:layout_height="90dp"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Marvel.Image"
                                tools:src="@drawable/placeholder_character" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/card_padding_compact"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/survival_enemy_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/text_primary"
                                    android:textAppearance="@style/TextAppearance.Marvel.Title"
                                    android:textStyle="bold"
                                    tools:text="Magneto"/>

                                <TextView
                                    android:id="@+id/survival_enemy_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Marvel.Caption"
                                    tools:text="OVR 62 · vida e dano × 73%"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/survival_enemy_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/survival_enemy_error_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textColor="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
                                tools:text="Sem conexão com a internet."/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/survival_enemy_retry"
                                style="@style/Widget.Marvel.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:insetTop="@dimen/button_compact_inset"
                                android:insetBottom="@dimen/button_compact_inset"
                                android:text="@string/action_retry" />
                        </LinearLayout>
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/survival_fight"
                        style="@style/Widget.Marvel.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_padding_compact"
                        android:enabled="false"
                        app:icon="@drawable/ic_bolt"
                        app:iconGravity="textStart"
                        tools:text="Lutar no andar 5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/survival_give_up"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/survival_give_up"
                        android:textColor="@color/text_muted" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/survival_debug_skip"
                        style="@style/Widget.Marvel.DebugButton"
                        android:layout_marginEnd="0dp"
                        android:text="@string/survival_debug_skip"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
