<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/market_image"
            android:layout_width="72dp"
            android:layout_height="90dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Marvel.Image"
            tools:src="@drawable/placeholder_character" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_padding_compact"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/market_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Marvel.Title"
                android:textStyle="bold"
                tools:text="Wolverine"/>

            <TextView
                android:id="@+id/market_real_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Marvel.Caption"
                tools:text="James Howlett"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:ignore="UseCompoundDrawables"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_group"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/market_teams"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Marvel.Caption"
                    tools:text="Avengers · X-Men  +9"/>
            </LinearLayout>

            <TextView
                android:id="@+id/market_overall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_pill_red"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="OVR 86" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/market_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.Marvel.Title"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_coin"
                app:drawableTint="@color/red"
                tools:text="3.050"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/market_buy"
                style="@style/Widget.Marvel.Button.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/market_buy" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
