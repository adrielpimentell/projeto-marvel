<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/hud_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_red_touch"
        android:drawablePadding="@dimen/space_sm"
        android:ellipsize="end"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/space_md"
        android:textColor="@color/red"
        android:textSize="13sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_medal"
        app:drawableTint="@color/red"
        tools:text="Vingador Supremo" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minWidth="6dp" />

    <TextView
        android:id="@+id/hud_trophies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="@drawable/bg_pill_surface"
        android:drawablePadding="@dimen/space_sm"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="36dp"
        android:paddingStart="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_trophy"
        app:drawableTint="@color/red"
        tools:text="1.250" />

    <include
        android:id="@+id/coin_chip"
        layout="@layout/view_coin_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
