<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/hud_profile"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/profile_open"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/hud_avatar"
            android:layout_width="@dimen/hud_avatar_size"
            android:layout_height="@dimen/hud_avatar_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/avatar_1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.Marvel.Headline"
            android:textColor="@color/text_primary"
            tools:text="T" />

        <View
            android:layout_width="@dimen/hud_avatar_size"
            android:layout_height="@dimen/hud_avatar_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_ring"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/hud_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="@drawable/bg_pill_red_touch"
        android:drawablePadding="@dimen/space_sm"
        android:ellipsize="end"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/space_md"
        android:textColor="@color/red"
        android:textSize="13sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_medal"
        app:drawableTint="@color/red"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/hud_trophies"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/hud_profile"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Vingador Supremo" />

    <TextView
        android:id="@+id/hud_trophies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_sm"
        android:background="@drawable/bg_pill_surface"
        android:drawablePadding="@dimen/space_sm"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="36dp"
        android:paddingStart="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_trophy"
        app:drawableTint="@color/red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/coin_chip"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1.250" />

    <include
        android:id="@+id/coin_chip"
        layout="@layout/view_coin_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
