<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs">

    <TextView
        android:id="@+id/section_title"
        style="@style/Widget.Marvel.SectionLabel"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_xs"
        tools:text="Seus membros (3)" />

    <TextView
        android:id="@+id/section_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Marvel.Caption"
        tools:text="Na ordem em que aparecem no Mercado"/>
</LinearLayout>
