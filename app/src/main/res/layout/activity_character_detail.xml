<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.detail.CharacterDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/battle_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="440dp">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/placeholder_character" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_gradient" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-72dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin">

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Marvel.DisplayLarge"
                    android:textColor="@color/text_primary"
                    tools:text="Wolverine"/>

                <TextView
                    android:id="@+id/detail_real_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Marvel.Body"
                    tools:text="James Howlett"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_card"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/card_padding_compact"
                    android:paddingBottom="@dimen/card_padding_compact">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_book"
                            app:tint="@color/red" />

                        <TextView
                            android:id="@+id/stat_issues_value"
                            style="@style/Widget.Marvel.StatValue"
                            tools:text="16.944" />

                        <TextView
                            style="@style/Widget.Marvel.StatLabel"
                            android:text="@string/stat_issues" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_movie"
                            app:tint="@color/red" />

                        <TextView
                            android:id="@+id/stat_movies_value"
                            style="@style/Widget.Marvel.StatValue"
                            tools:text="17" />

                        <TextView
                            style="@style/Widget.Marvel.StatLabel"
                            android:text="@string/stat_movies" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_group"
                            app:tint="@color/red" />

                        <TextView
                            android:id="@+id/stat_teams_value"
                            style="@style/Widget.Marvel.StatValue"
                            tools:text="58" />

                        <TextView
                            style="@style/Widget.Marvel.StatLabel"
                            android:text="@string/stat_teams" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/info_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/details_progress"
                    layout="@layout/view_skeleton_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/details_error"
                    layout="@layout/view_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <LinearLayout
                    android:id="@+id/details_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.Marvel.SectionLabel"
                        android:text="@string/section_attributes" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/attr_overall"
                                android:textAppearance="@style/TextAppearance.Marvel.Headline"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:id="@+id/overall_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Marvel.DisplayLarge"
                                android:textColor="@color/red"
                                tools:text="86"/>
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/overall_bar"
                            style="@style/Widget.Marvel.AttributeBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            app:trackThickness="12dp"
                            app:trackCornerRadius="6dp"
                            tools:progress="86" />

                        <include
                            android:id="@+id/attr_life"
                            layout="@layout/item_attribute_row" />

                        <include
                            android:id="@+id/attr_strength"
                            layout="@layout/item_attribute_row" />

                        <include
                            android:id="@+id/attr_speed"
                            layout="@layout/item_attribute_row" />

                        <include
                            android:id="@+id/attr_intelligence"
                            layout="@layout/item_attribute_row" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/card_padding_compact"
                            android:text="@string/attr_caption"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Marvel.Caption"/>
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.Marvel.SectionLabel"
                        android:text="@string/section_about" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            android:id="@+id/about_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.25"
                            android:textColor="@color/text_label"
                            android:textAppearance="@style/TextAppearance.Marvel.Body"
                            tools:text="Resumo do personagem vindo da Comic Vine."/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/open_article"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-12dp"
                            android:text="@string/action_open_article"
                            android:textColor="@color/red"
                            app:icon="@drawable/ic_open_in_new"
                            app:iconGravity="end"
                            app:iconSize="16dp"
                            app:iconTint="@color/red" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/powers_label"
                        style="@style/Widget.Marvel.SectionLabel"
                        tools:text="Poderes (24)" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/powers_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />

                    <TextView
                        android:id="@+id/teams_label"
                        style="@style/Widget.Marvel.SectionLabel"
                        tools:text="Times (58)" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/teams_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp" />

                    <TextView
                        android:id="@+id/movies_label"
                        style="@style/Widget.Marvel.SectionLabel"
                        tools:text="Filmes (17)" />

                    <LinearLayout
                        android:id="@+id/movies_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_sm" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/card_padding_compact"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_circle_scrim"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <include
        android:id="@+id/player_hud"
        layout="@layout/view_player_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/card_padding_compact"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_button"
        app:layout_constraintTop_toTopOf="@id/back_button" />

    <LinearLayout
        android:id="@+id/battle_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/card_padding_compact"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/detail_daily_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_trophy"
            app:drawableTint="@color/green"
            tools:text="Vale para o desafio: Derrote um inimigo de origem Mutante"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/battle_button"
            style="@style/Widget.Marvel.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/action_battle"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
