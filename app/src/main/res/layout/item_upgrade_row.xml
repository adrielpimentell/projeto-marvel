<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/upgrade_label"
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_label"
        android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
        tools:text="Inteligência"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/upgrade_bar"
        style="@style/Widget.Marvel.AttributeBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:progress="26" />

    <TextView
        android:id="@+id/upgrade_value"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="26" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/upgrade_button"
        style="@style/Widget.Marvel.Button.Compact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:minWidth="84dp"
        android:paddingStart="@dimen/card_padding_compact"
        android:paddingEnd="@dimen/card_padding_compact"
        android:textAppearance="@style/TextAppearance.Marvel.Caption"
        app:icon="@drawable/ic_add"
        app:iconPadding="2dp"
        app:iconSize="14dp"
        tools:text="150"/>
</LinearLayout>
