<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/team_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Marvel.Image"
            tools:src="@drawable/placeholder_character" />

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_hero_gradient" />

        <TextView
            android:id="@+id/team_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="@dimen/card_padding_compact"
            android:paddingEnd="@dimen/card_padding_compact"
            android:paddingBottom="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Marvel.Display"
            android:textColor="@color/text_primary"
            tools:text="Avengers"/>
    </FrameLayout>

    <TextView
        android:id="@+id/team_deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Marvel.BodySmall"
        tools:text="Earth's Mightiest Heroes."/>

    <TextView
        android:id="@+id/team_owned_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding_compact"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Marvel.Title"
        android:textStyle="bold"
        tools:text="Você tem 3 de 255 membros"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding_compact"
        android:background="@drawable/bg_card"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingTop="@dimen/card_padding_compact"
        android:paddingBottom="@dimen/card_padding_compact">

        <include
            android:id="@+id/team_milestone_0"
            layout="@layout/view_team_milestone" />

        <include
            android:id="@+id/team_milestone_1"
            layout="@layout/view_team_milestone" />

        <include
            android:id="@+id/team_milestone_2"
            layout="@layout/view_team_milestone" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/team_claim"
        style="@style/Widget.Marvel.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding_compact"
        app:icon="@drawable/ic_coin"
        app:iconGravity="textStart"
        tools:text="Resgatar 800 moedas" />
</LinearLayout>
