<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MergeRootFrame"
    android:id="@+id/roulette_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.market.RouletteSpinActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/space_lg">

        <TextView
            android:id="@+id/roulette_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Marvel.Display"
            android:textColor="@color/text_primary"
            tools:text="Roleta Épica"/>

        <TextView
            android:id="@+id/roulette_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chest_skip_hint"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Marvel.BodySmall"/>

        <FrameLayout
            android:id="@+id/roulette_stage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/card_padding_compact"
            android:layout_marginBottom="@dimen/card_padding_compact"
            android:clipChildren="false">

            <com.example.marvel.ui.market.RouletteWheelView
                android:id="@+id/roulette_wheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <include
            android:id="@+id/artifact_card"
            layout="@layout/view_reward_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/roulette_done"
        style="@style/Widget.Marvel.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/chest_continue"
        android:visibility="invisible" />
</FrameLayout>
