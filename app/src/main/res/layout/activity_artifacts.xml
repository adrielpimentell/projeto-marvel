<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/artifacts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.artifacts.ArtifactsActivity">

    <ImageButton
        android:id="@+id/back_button"
        style="@style/Widget.Marvel.IconButton"
        android:layout_marginStart="@dimen/card_padding_compact"
        android:layout_marginTop="@dimen/space_sm"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/player_hud"
        layout="@layout/view_player_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_button"
        app:layout_constraintTop_toTopOf="@id/back_button" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/back_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                style="@style/Widget.Marvel.ScreenTitle"
                android:text="@string/artifacts_title" />

            <TextView
                style="@style/Widget.Marvel.ScreenSubtitle"
                android:text="@string/artifacts_subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_compact">

                <TextView
                    android:id="@+id/artifacts_hero_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Marvel.Title"
                    android:textStyle="bold"
                    tools:text="Herói ativo: Lucas Jackson"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_compact"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/slot_1"
                        layout="@layout/view_artifact_slot" />

                    <Space
                        android:layout_width="@dimen/space_sm"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/slot_2"
                        layout="@layout/view_artifact_slot" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.Marvel.SectionLabel"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/artifacts_preview_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/preview_life"
                        layout="@layout/view_stat_column" />

                    <include
                        android:id="@+id/preview_strength"
                        layout="@layout/view_stat_column" />

                    <include
                        android:id="@+id/preview_speed"
                        layout="@layout/view_stat_column" />

                    <include
                        android:id="@+id/preview_intelligence"
                        layout="@layout/view_stat_column" />

                    <include
                        android:id="@+id/preview_overall"
                        layout="@layout/view_stat_column" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/artifacts_collection_label"
                style="@style/Widget.Marvel.SectionLabel"
                tools:text="Coleção · 5 de 18" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artifacts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
