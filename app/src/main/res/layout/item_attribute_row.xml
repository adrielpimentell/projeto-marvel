<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_padding_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/attribute_label"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_label"
        android:textAppearance="@style/TextAppearance.Marvel.Body"
        tools:text="Velocidade"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/attribute_bar"
        style="@style/Widget.Marvel.AttributeBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:progress="70" />

    <TextView
        android:id="@+id/attribute_value"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.Marvel.Title"
        android:textStyle="bold"
        tools:text="70"/>
</LinearLayout>
